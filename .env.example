# From @BotFather after /newbot (leave placeholder to run API without polling)
BOT_TOKEN=000000:REPLACE_ME

# Public HTTPS URL of the Mini App (Vercel production URL / tunnel)
WEBAPP_URL=https://your-project.vercel.app

# Backend (local only)
PORT=3001
# Comma-separated origins allowed to call the API (include WEBAPP_URL)
CORS_ORIGIN=http://localhost:5173,https://your-project.vercel.app

# JWT secret for session cookies after initData validation
SESSION_SECRET=change-me-to-a-long-random-string
