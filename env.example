BOT_TOKEN=123456:ABC-DEF
BOT_USERNAME=your_bot_username
WEBAPP_URL=https://your-app.vercel.app
CORS_ORIGIN=https://your-app.vercel.app,http://localhost:5173
SESSION_SECRET=replace-with-long-random-string

# Local: leave empty → file DB at ./data/app.db
# Vercel: Turso (https://turso.tech) — required
DATABASE_URL=libsql://your-db.turso.io
DATABASE_AUTH_TOKEN=

# Required in production (at least 16 characters).
# Vercel Cron sends Authorization: Bearer $CRON_SECRET. x-vercel-cron is not checked.
CRON_SECRET=
